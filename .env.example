ANTHROPIC_API_KEY=
# Optional: CV file name, CV_<this>.pdf (default: AdrianMatei)
CANDIDATE_FILENAME=
# Optional cost settings (defaults in cvgen/settings.py, explained in CLAUDE.md, "Cost settings")
# The CV: model and effort (defaults: claude-opus-5-5, medium). CV_MODEL / CV_EFFORT still work.
TAILOR_MODEL=
TAILOR_EFFORT=
# Skill-gap report: model, effort, web searches per report when web search is on (defaults: claude-opus-5-5, medium, 3)
GAP_MODEL=
GAP_EFFORT=
GAP_MAX_SEARCHES=
# Skill-gap report links: search links (0, default) or Anthropic web search (1; about doubles the report's cost)
GAP_WEB_SEARCH=
# Layout widow rewrites (defaults: claude-haiku-5-5, medium)
LAYOUT_MODEL=
LAYOUT_EFFORT=
# Cache lifetime of the profile prefix: 5m (default) or 1h
CACHE_TTL=
